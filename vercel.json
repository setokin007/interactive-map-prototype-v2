{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "outputDirectory": "site",
  "rewrites": [
    {
      "source": "/",
      "destination": "/Shape.dc.html"
    },
    {
      "source": "/plan",
      "destination": "/Shape.dc.html"
    },
    {
      "source": "/myday",
      "destination": "/Shape.dc.html"
    },
    {
      "source": "/app",
      "destination": "/App-Today.dc.html"
    },
    {
      "source": "/app-map",
      "destination": "/App-Map.dc.html"
    },
    {
      "source": "/app-replan",
      "destination": "/App-Late.dc.html"
    },
    {
      "source": "/app-alert",
      "destination": "/App-Alert.dc.html"
    },
    {
      "source": "/v1/packages",
      "destination": "/Discover.dc.html"
    },
    {
      "source": "/v1/planner",
      "destination": "/Main.dc.html"
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
